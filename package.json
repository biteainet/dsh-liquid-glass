{
  "name": "dsh-liquid-glass",
  "version": "1.0.0",
  "description": "把 DeepSeek Harness 的全部 UI（输入框/按钮/面板/侧边栏等）变成 Apple 液态玻璃。使用真实开源实现 apple-liquid-glass-webgl@2.5.0（esbuild 打包内联，源码未修改）；另提供全局自定义背景（应用到整个 DSH 界面）与自绘玻璃风设置面板（右侧小球入口）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "liquid-glass",
    "glassmorphism",
    "apple",
    "webgl",
    "webgl2",
    "backdrop",
    "wallpaper",
    "custom-background",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
